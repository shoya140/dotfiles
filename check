#!/bin/bash
# Report what mise has no command for: App Store apps nobody declared and System Settings changed since the
# last snapshot.
# `check --accept` takes the current preferences as the new snapshot. Runs on the bash 3.2 that ships with macOS.
set -euo pipefail

REPO_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
SCRIPTS_DIR="$REPO_DIR/base/scripts"
SNAPSHOT_DIR="${DOTFILES_STATE_DIR:-$HOME/.local/state/dotfiles}/snapshot"
SNAPSHOT_IGNORE="$SCRIPTS_DIR/snapshot-ignore.conf"
MISE_CONFIG_DIR="${MISE_CONFIG_DIR:-$HOME/.config/mise}"
DRIFT_COUNT=0
DRIFT_SUMMARY=""

if [ -t 1 ]; then
  C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_BLUE=$'\033[34m' C_RESET=$'\033[0m'
else
  C_RED="" C_GREEN="" C_BLUE="" C_RESET=""
fi

section() { printf '\n%s== %s ==%s\n' "$C_BLUE" "$1" "$C_RESET"; }
info()    { printf '   %s\n' "$*"; }
ok()      { printf '%s ✓ %s%s\n' "$C_GREEN" "$*" "$C_RESET"; }

drift() {
  DRIFT_COUNT=$((DRIFT_COUNT + 1))
  DRIFT_SUMMARY="${DRIFT_SUMMARY}${1}"$'\n'
  printf '%s ✗ %s%s\n' "$C_RED" "$1" "$C_RESET"
  if [ $# -gt 1 ]; then
    shift
    printf '%s\n' "$@" | sed '/^$/d; s/^/     /'
  fi
}

# Items of the whitespace-separated list $1 that are not in $2
list_minus() {
  comm -23 <(printf '%s\n' $1 | sed '/^$/d' | sort -u) <(printf '%s\n' $2 | sed '/^$/d' | sort -u)
}

linked_roles() {
  local link
  for link in "$MISE_CONFIG_DIR"/conf.d/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in */roles/*) basename "$link" ;; esac
  done
}

declared_domains() {
  mise bootstrap macos defaults status --json | python3 -I "$SCRIPTS_DIR/status.py" domains
}

check_mas() {
  section "App Store apps"
  if ! command -v mas >/dev/null 2>&1; then
    info "mas is not installed, skipped"
    return
  fi
  local declared apps extra
  if ! declared=$(mise bootstrap packages status --json | python3 -I "$SCRIPTS_DIR/status.py" declared mas); then
    drift "mise could not read the config (run: mise bootstrap status)"
    return
  fi
  apps=$(mas list 2>/dev/null | sed -E 's/ +\([^)]*\)$//' | awk '{id=$1; $1=""; sub(/^ +/, ""); print id "  " $0}' || true)
  extra=$(list_minus "$(printf '%s\n' "$apps" | awk '{print $1}')" "$declared")
  if [ -z "$extra" ]; then
    ok "every installed App Store app is declared"
    return
  fi
  drift "App Store apps installed but not declared (run: mise bootstrap packages use -p <file> mas:<id>)" \
    "$(for id in $extra; do printf '%s\n' "$apps" | awk -v id="$id" '$1 == id'; done)"
}

snapshot_file() { # host domain
  if [ "$1" = "current" ]; then
    echo "$SNAPSHOT_DIR/$2.currentHost.json"
  else
    echo "$SNAPSHOT_DIR/$2.json"
  fi
}

snapshot_capture() { # host domain -> stdout
  if [ "$1" = "current" ]; then
    defaults -currentHost export "$2" -
  else
    defaults export "$2" -
  fi | python3 -I "$SCRIPTS_DIR/snapshot.py" "$2" "$SNAPSHOT_IGNORE"
}

check_snapshot() {
  section "System Settings (macOS defaults changed since the last snapshot)"
  local domains host domain file created=0 same=0 changed=0
  if ! domains=$(declared_domains); then
    drift "mise could not read the config (run: mise bootstrap status)"
    return
  fi
  mkdir -p "$SNAPSHOT_DIR"
  while IFS=$'\t' read -r host domain; do
    [ -n "$domain" ] || continue
    file=$(snapshot_file "$host" "$domain")
    snapshot_capture "$host" "$domain" > "$file.new"
    if [ ! -f "$file" ]; then
      mv "$file.new" "$file"
      created=$((created + 1))
    elif diff -q "$file" "$file.new" >/dev/null; then
      rm "$file.new"
      same=$((same + 1))
    else
      drift "$domain$([ "$host" = "current" ] && echo " (current host)"): changed since the last snapshot" \
        "$(diff -u -L snapshot -L now "$file" "$file.new" | sed -n '3,60p')"
      rm "$file.new"
      changed=$((changed + 1))
    fi
  done <<< "$domains"
  [ "$created" -eq 0 ] || info "$created baseline snapshot(s) created in $SNAPSHOT_DIR"
  [ "$same" -eq 0 ] || ok "$same domain(s) unchanged since the last snapshot"
  [ "$changed" -eq 0 ] || info "To keep a change, declare it in base/mise.toml or the role, or ignore the key in base/scripts/snapshot-ignore.conf, then run: $REPO_DIR/check --accept"
}

snapshot_accept() {
  local domains host domain
  domains=$(declared_domains)
  mkdir -p "$SNAPSHOT_DIR"
  while IFS=$'\t' read -r host domain; do
    [ -n "$domain" ] || continue
    snapshot_capture "$host" "$domain" > "$(snapshot_file "$host" "$domain")"
  done <<< "$domains"
  ok "took the current preferences as the snapshot in $SNAPSHOT_DIR"
}

cmd_check() {
  local roles
  roles=$(linked_roles | paste -sd ' ' -)
  printf 'check  %s  %s  role: %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(scutil --get ComputerName 2>/dev/null || hostname -s)" "${roles:-none}"
  [ -n "$roles" ] || drift "no role is linked in $MISE_CONFIG_DIR/conf.d (run: $REPO_DIR/setup <role>)"
  check_mas
  check_snapshot
  section "Summary"
  if [ "$DRIFT_COUNT" -eq 0 ]; then
    ok "nothing to review"
  else
    printf '%s ✗ %s item(s) to review:%s\n' "$C_RED" "$DRIFT_COUNT" "$C_RESET"
    printf '%s' "$DRIFT_SUMMARY" | sed 's/^/     /'
  fi
  info "mise checks the rest: mise bootstrap --dry-run, mise bootstrap packages prune --dry-run [-m brew-cask]"
  [ "$DRIFT_COUNT" -eq 0 ]
}

case "${1:-}" in
  "") cmd_check ;;
  --accept) snapshot_accept ;;
  *) echo "usage: $0 [--accept]" >&2; exit 1 ;;
esac

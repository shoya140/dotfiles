{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git symbolic-ref *)",
      "Bash(git remote -v)",
      "Bash(git fetch --prune *)",
      "Bash(git pull --ff-only *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(* --version)",
      "Bash(* --help *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git reset --mixed*)",
      "Bash(git reset --soft*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(git restore -- *)",
      "Bash(git config --global *)",
      "Bash(git config -g *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.*)",
      "Edit(./.env*)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/shoya/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "crit@crit": true,
    "cosense-cli@cosense-cli": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    }
  },
  "effortLevel": "xhigh",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "fileCheckpointingEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  }
}

#!/bin/bash
# Set up the oMLX server on another Mac over SSH, as an administrator of that Mac: setup <user@host>.
# Safe to run again. See README.md for what it does and what to prepare.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

[ $# -eq 1 ] && [ "${1#-}" = "$1" ] || { echo "usage: $0 <user@host>" >&2; exit 1; }
target=$1

work=$(mktemp -d)
# No agent or port forwarding, so nothing on the target can reach back through these connections
ssh_opts=(-o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes
  -o ControlMaster=auto -o "ControlPath=$work/ssh" -o ControlPersist=120)
remote=""
cleanup() {
  [ -z "$remote" ] || ssh "${ssh_opts[@]}" "$target" "rm -rf '$remote'" || true
  ssh -S "$work/ssh" -O exit "$target" 2>/dev/null || true
  rm -rf "$work"
}
trap cleanup EXIT

remote=$(ssh "${ssh_opts[@]}" "$target" 'mktemp -d')
COPYFILE_DISABLE=1 tar -C "$SCRIPT_DIR" -cf - remote -C "$SCRIPT_DIR/.." lib |
  ssh "${ssh_opts[@]}" "$target" "umask 077 && tar -xf - -C '$remote'"
ssh -t "${ssh_opts[@]}" "$target" "/bin/bash '$remote/remote/setup.sh'"
